{
  "name": "wearside-giants",
  "main": "../../worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/icon-192.png", "/icon-512.png", "/apple-touch-icon.png"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "wearside-giants-trial", "database_id": "2acaf9a9-646d-44ab-9cc0-4fd5d8a8b135" }
  ]
}
