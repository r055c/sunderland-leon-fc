{
  "name": "norton",
  "main": "../../worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/icon-192.png", "/icon-512.png", "/apple-touch-icon.png"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "norton-trial", "database_id": "ed2b50fa-38bb-4531-a36d-61ae86bc23ca" }
  ]
}
