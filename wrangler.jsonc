{
  "name": "leon",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/icon-192.png", "/icon-512.png", "/apple-touch-icon.png"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "leon-trial", "database_id": "78933dc8-c453-47e7-a3be-6db835984fe9" }
  ]
}
